<launch>
  <node pkg="nodelet"
        type="nodelet"
        name="pcl_manager"
        args="manager"
        output="screen" />

  <node pkg="nodelet"
        type="nodelet"
        name="voxel_grid_filter"
        args="load pcl/VoxelGrid pcl_manager"
        output="screen">

    <remap from="~input" to="/camera/depth/points" />
    <remap from="~output" to="/points_filtered" />

    <rosparam>
      leaf_size: 0.05
      filter_field_name: z
      filter_limit_min: 0.1
      filter_limit_max: 4.0
      filter_limit_negative: false
    </rosparam>
  </node>
</launch>
