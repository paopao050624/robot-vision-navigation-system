<launch>
  <param name="/use_sim_time" value="true" />

  <arg name="rgb_topic" default="/camera/rgb/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="camera_info_topic" default="/camera/rgb/camera_info" />
  <arg name="scan_topic" default="/scan" />
  <arg name="odom_topic" default="/odom" />

  <!-- 自动生成的相机 TF 修复文件 -->
  <include file="$(find robot_nav_slam)/launch/camera_tf_fix.launch" />

  <!-- RGB + Depth + CameraInfo 同步为 /rgbd_image -->
  <node pkg="rtabmap_sync"
        type="rgbd_sync"
        name="rgbd_sync"
        output="screen">
    <param name="approx_sync" value="true" />
    <param name="queue_size" value="50" />

    <remap from="rgb/image" to="$(arg rgb_topic)" />
    <remap from="depth/image" to="$(arg depth_topic)" />
    <remap from="rgb/camera_info" to="$(arg camera_info_topic)" />
    <remap from="rgbd_image" to="/rgbd_image" />
  </node>

  <!-- RTAB-Map 主建图节点 -->
  <node pkg="rtabmap_slam"
        type="rtabmap"
        name="rtabmap"
        output="screen"
        args="--delete_db_on_start">

    <param name="frame_id" value="base_footprint" />

    <param name="subscribe_rgbd" value="true" />
    <param name="subscribe_scan" value="true" />
    <param name="subscribe_odom_info" value="false" />
    <param name="approx_sync" value="true" />
    <param name="queue_size" value="50" />
    <param name="wait_for_transform_duration" value="2.0" />

    <param name="Reg/Strategy" value="1" />
    <param name="RGBD/ProximityBySpace" value="true" />
    <param name="Grid/FromDepth" value="true" />
    <param name="Grid/3D" value="true" />
    <param name="Grid/RangeMax" value="4.0" />

    <remap from="rgbd_image" to="/rgbd_image" />
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>

  <!-- RTAB-Map 可视化节点：显式订阅 /rgbd_image -->
  <node pkg="rtabmap_viz"
        type="rtabmap_viz"
        name="rtabmap_viz"
        output="screen">

    <param name="frame_id" value="base_footprint" />
    <param name="subscribe_rgbd" value="true" />
    <param name="subscribe_scan" value="true" />
    <param name="subscribe_odom_info" value="false" />
    <param name="approx_sync" value="true" />
    <param name="queue_size" value="50" />
    <param name="wait_for_transform_duration" value="2.0" />

    <remap from="rgbd_image" to="/rgbd_image" />
    <remap from="scan" to="$(arg scan_topic)" />
    <remap from="odom" to="$(arg odom_topic)" />
  </node>
</launch>
