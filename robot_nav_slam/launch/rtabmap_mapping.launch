<launch>
  <param name="/use_sim_time" value="true" />

  <arg name="rgb_topic" default="/camera/rgb/image_raw" />
  <arg name="depth_topic" default="/camera/depth/image_raw" />
  <arg name="camera_info_topic" default="/camera/rgb/camera_info" />
  <arg name="frame_id" default="base_footprint" />
  <arg name="odom_frame_id" default="odom" />

  <!-- Static TF generated by generate_camera_tf_fix.py -->
  <include file="$(find robot_nav_slam)/launch/camera_tf_fix.launch" />

  <!-- RTAB-Map main node: RGB-D only, no LaserScan -->
  <node pkg="rtabmap_slam"
        type="rtabmap"
        name="rtabmap"
        output="screen"
        args="--delete_db_on_start">

    <param name="frame_id" value="$(arg frame_id)" />
    <param name="odom_frame_id" value="$(arg odom_frame_id)" />

    <!-- 关键修改：关闭 scan，避免 base_scan TF 错误中断建图 -->
    <param name="subscribe_depth" value="true" />
    <param name="subscribe_scan" value="false" />
    <param name="subscribe_odom_info" value="false" />

    <param name="approx_sync" value="true" />
    <param name="queue_size" value="50" />
    <param name="wait_for_transform_duration" value="2.0" />

    <!-- 调试阶段降低更新门槛 -->
    <param name="RGBD/LinearUpdate" value="0.0" />
    <param name="RGBD/AngularUpdate" value="0.0" />
    <param name="Rtabmap/DetectionRate" value="1.0" />
    <!-- RGB-D 建图参数 -->
    <param name="Reg/Strategy" value="0" />
    <param name="RGBD/ProximityBySpace" value="true" />
    <param name="RGBD/OptimizeFromGraphEnd" value="false" />
    <param name="Grid/FromDepth" value="true" />
    <param name="Grid/3D" value="true" />
    <param name="Grid/RangeMax" value="4.0" />

    <remap from="rgb/image" to="$(arg rgb_topic)" />
    <remap from="depth/image" to="$(arg depth_topic)" />
    <remap from="rgb/camera_info" to="$(arg camera_info_topic)" />
  </node>

  <!-- RTAB-Map visualization node -->
  <node pkg="rtabmap_viz"
        type="rtabmap_viz"
        name="rtabmap_viz"
        output="screen">

    <param name="frame_id" value="$(arg frame_id)" />
    <param name="odom_frame_id" value="$(arg odom_frame_id)" />

    <!-- 关键修改：可视化也关闭 scan -->
    <param name="subscribe_depth" value="true" />
    <param name="subscribe_scan" value="false" />
    <param name="subscribe_odom_info" value="false" />

    <param name="approx_sync" value="true" />
    <param name="queue_size" value="50" />
    <param name="wait_for_transform_duration" value="2.0" />

    <remap from="rgb/image" to="$(arg rgb_topic)" />
    <remap from="depth/image" to="$(arg depth_topic)" />
    <remap from="rgb/camera_info" to="$(arg camera_info_topic)" />
  </node>
</launch>
