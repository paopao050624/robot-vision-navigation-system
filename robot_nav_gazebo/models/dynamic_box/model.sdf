<?xml version="1.0"?>
<sdf version="1.6">
  <model name="dynamic_box">
    <static>false</static>

    <link name="link">
      <pose>0 0 0.3 0 0 0</pose>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.4 0.4 0.6</size>
          </box>
        </geometry>
