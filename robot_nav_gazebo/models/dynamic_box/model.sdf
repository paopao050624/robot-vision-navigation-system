      <visual name="visual">
        <geometry>
          <box>
            <size>0.4 0.4 0.6</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
